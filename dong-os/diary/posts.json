---
layout: null
---
[{% for p in site.posts %}
  {
    "title": {{ p.title | jsonify }},
    "date": {{ p.date | date: "%Y-%m-%d %H:%M" | jsonify }},
    "mood": {{ p.mood | jsonify }},
    "weather": {{ p.weather | jsonify }},
    "content": {{ p.content | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
